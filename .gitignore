node_modules/
# dist/ is COMMITTED on purpose. Claude Code installs plugin dependencies with
# `npm ci --ignore-scripts` and never runs a build script, so a plugin whose
# hooks point at compiled output must ship that output or every hook is a
# no-op on the user's machine.
*.log
.DS_Store

# secrets — never commit
.env
.env.*

# benchmark run artefacts
bench/.work/
bench/results/transcripts/

bench/results/*.log
bench/results/*.bak
